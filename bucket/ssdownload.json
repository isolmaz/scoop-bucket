{
    "version": "1.11.0",
    "description": "Native Windows file, video and audio download manager",
    "homepage": "https://ssdownload.isolmaz.com",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/isolmaz/SSDownload/releases/download/v1.11.0/SSDownload-1.11.0-win64.zip",
            "hash": "12a90feb1ed2e0d5a1e866d9024e298d1faa36503e0244c85c72f14614bc5bc1",
            "extract_dir": "SSDownload-1.11.0-win64"
        }
    },
    "bin": [["ssdownload-cli.exe", "ssdownload"]],
    "shortcuts": [["ssdownload.exe", "SSDownload"]],
    "post_install": [
        "& \"$dir\\ssdownload-cli.exe\" --register-host",
        "if ($LASTEXITCODE -ne 0) { warn 'The SSDownload browser integration could not be registered; run: ssdownload --register-host' }"
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') { & \"$(Split-Path $dir)\\current\\ssdownload-cli.exe\" --disable-autostart | Out-Null }",
        "& \"$dir\\ssdownload-cli.exe\" --unregister-host",
        "if ($LASTEXITCODE -ne 0) { warn 'The SSDownload browser integration of this copy could not be removed.' }",
        "$setup = (Get-ItemProperty 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\SSDownload' -ErrorAction SilentlyContinue).InstallLocation",
        "if ($cmd -eq 'uninstall' -and $setup -and (Test-Path \"$setup\\ssdownload-cli.exe\")) { & \"$setup\\ssdownload-cli.exe\" --register-host | Out-Null }"
    ],
    "checkver": {
        "github": "https://github.com/isolmaz/SSDownload"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/isolmaz/SSDownload/releases/download/v$version/SSDownload-$version-win64.zip",
                "extract_dir": "SSDownload-$version-win64",
                "hash": {
                    "url": "$baseurl/SHA256SUMS"
                }
            }
        }
    }
}
